    *

// github.anuv.me blockfile

// define custom blocks
!break
    init
        {
            return Block('span').add('br');
        }
    load
        {
            data('val', function (val) {
                for (var i = 1; i < val; i++)
                    block.add('br');
            });
        }
!text
    init
        {
            return Block('span');
        }
    load
        {
            data('val', function (val) {
                block.node().appendChild(document.createTextNode(val));
            });
            data('html', function (html) {
                block.html(html);
            });
        }
!image
    init
        {
            return Block('div');
        }
    load
        {
            var src = data('src');
            var height = data('height');
            var width = data('width');
            var alt = data('alt');
            if (src != null) {
                block.css('background-image', "url('" + src + "')")
                    .css('background-repeat', 'no-repeat')
                    .css('background-size', 'contain')
                ;
            }
            if (height !== null) block.css('height', height);
            if (width !== null) block.css('width', width);
            if (alt !== null) block.attribute('title', alt);
        }
!social-icon
    init
        {
            return Block('div')
                .add(Block('a', 'link')
                    .add('image', 1)
                    .data({
                        target: '_blank'
                    })
                )
                .css({
                    display: 'inline-block',
                    margin: '0 10px 10px',
                    cursor: 'pointer',
                    transition: 'opacity 0.25s ease'
                })
                .on('mouseover', function (e, b) {
                    b.css('opacity', '0.7');
                })
                .on('mouseout', function (e, b) {
                    b.css('opacity', '0.45');
                })
                .on('mouseout')
            ;
        }
    load
        {
            var src = 'img/social-icons/' + block.mark() + '.png';
            data('src', function (_src) {
                src = _src;
            });
            block.child('link/image').data({
                src: src,
                height: '55px',
                width: '55px'
            });
            data('href', function (href) {
                block.child('link').data({
                    href: href
                });
            });
            data('target', function (target) {
                block.child('link').data({
                    target: target
                });
            });
            data('alt', function (alt) {
                block.attribute('title', alt);
            });
        }
!menu-item
    init
        {
            var block = Block('block');
            return block
                .key('link', false)
                .key('alt', false)
                .css({
                    cursor: 'pointer'
                })
                .query('window width > 1100', function () {
                    if (block.key('alt')) {
                        block.child('text').html(block.key('title'));
                    }
                    block.css({
                        display: 'table',
                        width: '100%',
                        height: '40px',
                        margin: '30px 5px 30px 15px'
                    });
                    block.child('text').css({
                        fontSize: '20px',
                        paddingLeft: '25px',
                        paddingRight: '50px'
                    });
                    block.__child('content').css('text-align', 'left');
                    block.on('mouseout');
                })
                .query('window width <= 1100', function () {
                    if (block.key('alt')) {
                        block.child('text').html(block.key('alt'));
                    }
                    block.css({
                        display: 'inline-table',
                        width: 'auto',
                        height: '100%',
                        margin: '0'
                    });
                    block.child('text').css({
                        fontSize: '23px',
                        paddingLeft: '30px',
                        paddingRight: '30px'
                    });
                    block.__child('content').css('text-align', 'left');
                    block.on('mouseout');
                })
                .query('window width <= 850', function () {
                    if (block.key('alt')) {
                        block.child('text').html(block.key('alt'));
                    }
                    block.css({
                        display: 'inline-table',
                        width: 'auto',
                        height: '100%',
                        margin: '0'
                    });
                    block.child('text').css({
                        fontSize: '20px',
                        paddingLeft: '20px',
                        paddingRight: '20px'
                    });
                    block.__child('content').css('text-align', 'left');
                    block.on('mouseout');
                })
                .query('window width <= 700', function () {
                    if (block.key('alt')) {
                        block.child('text').html(block.key('alt'));
                    }
                    block.css({
                        display: 'inline-table',
                        width: '33%',
                        height: '100%',
                        margin: '0'
                    });
                    block.child('text').css({
                        fontSize: '20px',
                        paddingLeft: '0',
                        paddingRight: '0'
                    });
                    block.__child('content').css('text-align', 'center');
                    block.on('mouseout');
                })
                .add(Block('text', 1)
                    .data('Menu Item')
                    .css({
                        fontSize: '20px',
                        textDecoration: 'none',
                        paddingLeft: '25px',
                        textTransform: 'uppercase',
                        letterSpacing: '5px',
                        //borderRadius: '2px',
                        cursor: 'pointer'
                    })
                )
                .on('mouseover', (e, b) => {
                    if (window.innerWidth > 1100) {
                        block.child('text').css('color', '#555').css('borderLeft', '3px solid rgba(40, 40, 40, 0.1');
                    } else {
                        block.child('text').css('color', '#777').css('borderLeft', 'none');
                    }
                })
                .on('mouseout', (e, b) => {
                    if (window.innerWidth > 1100) {
                        block.child('text').css('color', '#222').css('borderLeft', '3px solid rgba(0, 0, 0, 0)');
                    } else {
                        block.child('text').css('color', '#222').css('borderLeft', 'none');
                    }
                })
                .on('mouseout')
                .on('click', (e, b) => {
                    var link = block.key('link');
                    if (block.key('link')) {
                        window.open(link, '_blank');
                    }
                })
            ;
        }
    load
        {
            data('title', function (title) {
                block.key('title', title);
                block.child('text').html(title);
            });
            data('altTitle', function (altTitle) {
                block.key('alt', altTitle);
            });
            data('link', function (link) {
                block.key('link', link);
            });
        }
!menubar-item
    init
        {
            var block = Block('div');
            return block
                .css({
                    "margin-left": "10px",
                    "width": "auto",
                    "height": "100%",
                    "display": "inline-block"
                })
                .on('activate', _ => {
                    block.key('activated', 'true');
                    block.child('block/button').css({
                        backgroundColor: '#0253b5',
                        color: 'white'
                    });
                })
                .on('deactivate', _ => {
                    block.key('activated', 'false');
                    block.child('block/button').css({
                        backgroundColor: '#fff',
                        color: '#0253b5'
                    });
                })
                .add(Block('block', 1)
                    .css({ width: "auto" })
                    .add(Block('block', 'button')
                        .css({
                            'width': 'auto',
                            'height': '32px',
                            'border-radius': '4px',
                            'padding': '0 15px',
                            'cursor': 'pointer',
                            'background-color': '#fff',
                            'transition': 'background-color 0.2s ease',
                            'color': '#0253b5'
                        })
                        .add(Block('text', 1)
                            .data('Filter')
                            .css({
                                'font-size': '15px',
                                'cursor': 'pointer',
                                'color': 'inherit'
                            })
                        )
                        .on('mouseover', (e, b) => {
                            if (block.key('activated') != 'true')
                                b.css('background-color', '#f4f4f4');
                        })
                        .on('mouseout', (e, b) => {
                            if (block.key('activated') != 'true')
                                b.css('background-color', '#fff');
                        })
                        .on('click', _ => {
                            app.limit_projects(block.key('val'));
                            var sibs = block.siblings();
                            for (var s in sibs) {
                                sibs[s].on('deactivate');
                            }
                            block.on('activate');
                            setTimeout(_ => {
                                block.sibling('counter').on('update');
                            }, 25);
                        })
                    )
                )
            ;
        }
    load
        {
            data('val', val => {
                block.key('val', val);
                block.child('block/button/text').html('').data(val.charAt(0).toUpperCase() + val.slice(1));
            });
            data('text', text => {
                block.child('block/button/text').html('').data(text.charAt(0).toUpperCase() + text.slice(1));
            });
        }
!project-tile
    init
        {
            var block = Block('div');
            return block
                .key('repo', false)
                .key('secondaryLink', false)
                .key('description', '')
                .key('tagline', '')
                .class('project-tile')
                .css({
                    position: 'relative',
                    margin: '0',
                    //borderRight: '1.5px solid #eaeaea',
                    //borderBottom: '1.5px solid #eaeaea',
                    float: 'left',
                    padding: '0',
                    outline: '0',
                    boxSizing: 'border-box',
                    cursor: 'inherit'
                })
                .query('window height != 0', function () {
                    var size = block.parent().key('tileWidth');
                    block.css({
                        height: size + 'px',
                        width: size + 'px'
                    });
                    if (size > 350) {
                        block.child('content/title-wrap/title/text').css('font-size', '40px');
                        block.child('content/desc').css('font-size', '16px').css('padding-bottom', '15px');
                        block.child('content/secondButton/text').css('font-size', '18px')
                        block.child('content/sourceButton/text').css('font-size', '18px');
                        block.child('content/hr').css('width', '100px');
                    } else {
                        block.child('content/title-wrap/title/text').css('font-size', '35px');
                        block.child('content/desc').css('font-size', '14px').css('padding-bottom', '5px');
                        block.child('content/secondButton/text').css('font-size', '16px');
                        block.child('content/sourceButton/text').css('font-size', '16px');
                        block.child('content/hr').css('width', '75px');
                    }
                })
                .add(Block('div', 'background')
                    .css({
                        background: 'url("img/projects/default.png") no-repeat center center scroll',
                        backgroundSize: 'cover',
                        height: '100%',
                        width: '100%',
                        position: 'absolute',
                        top: '0',
                        left: '0',
                        zIndex: '3',
                        opacity: '1',
                        transition: 'opacity 0.4s ease'
                    })
                    .on('show', function (e, b) {
                        b.css('opacity', '0.99');
                    })
                    .on('hide', function (e, b) {
                        b.css('opacity', '0.05');
                    })
                    // .on('medium', function (e, b) {
                    //     b.css('opacity', '0.85');
                    // })
                )
                .add(Block('block', 'content')
                    .__child('content').css('text-align', 'left').__parent()
                    .key('active', true)
                    .css({
                        position: 'absolute',
                        height: '100%',
                        width: '100%',
                        top: '0',
                        left: '0',
                        zIndex: '4',
                        opacity: '1',
                        transition: 'opacity 0.7s ease',
                        textAlign: 'center',
                        // cursor: 'pointer',
                        backgroundColor: 'rgba(255, 255, 255, 0.4)',
                        cursor: 'inherit'
                    })
                    .on('mouseover', function (e, b) {
                        b.sibling('background').on('hide');
                        b.on('show');
                    })
                    .on('mouseout', function (e, b) {
                        b.sibling('background').on('show');
                        b.on('hide');
                    })
                    .on('show', function (e, b) {
                        // if (!b.key('active')) {
                        //     b.css('display', 'table');
                        //     setTimeout(function () {
                        //         b.css('opacity', '1');
                        //     }, 50);
                        //     b.key('active', true);
                        // }
                        b.css('opacity', '1');
                    })
                    .on('hide', function (e, b) {
                        // if (b.key('active')) {
                        //     b.css('opacity', '0');
                        //     setTimeout(function () {
                        //         b.css('display', 'none');
                        //     }, 400);
                        //     b.key('active', false);
                        // }
                        b.css('opacity', '0');
                    })
                    .add(Block('div', 'year')
                        .css({
                            position: 'absolute',
                            right: '11%',
                            bottom: '6%',
                            display: 'none',
                            cursor: 'inherit'
                        })
                        .add(Block('text', 1)
                            .data('Year')
                            .css({
                                color: '#555',
                                fontSize: '15px',
                                cursor: 'inherit'
                            })
                        )
                    )
                    .add(Block('div', 'status')
                        .css({
                            position: 'absolute',
                            left: '12%',
                            bottom: '6%',
                            cursor: 'inherit'
                        })
                        .add(Block('image', 'image-maj')
                            .data({
                                height: '20px',
                                width: '20px',
                                src: 'img/verified_b.png',
                                css: {
                                    display: 'inline-block',
                                    position: 'relative',
                                    verticalAlign: 'middle',
                                    marginRight: '8px',
                                    opacity: '0.8',
                                    cursor: 'pointer'
                                }
                            })
                            .on('mouseover', (e, b, d) => {
                                b.sibling('text-maj').css('width', '58px');
                            })
                            .on('mouseout', (e, b, d) => {
                                b.sibling('text-maj').css('width', '0px');
                            })
                        )
                        .add(Block('text', 'text-maj')
                            .data('Flagship')
                            .css({
                                position: 'relative',
                                verticalAlign: 'middle',
                                fontSize: '15px',
                                width: '0px',
                                transition: 'width 0.3s ease',
                                overflow: 'hidden',
                                display: 'inline-block'
                            })
                        )
                        .add(Block('image', 1)
                            .data({
                                height: '20px',
                                width: '20px',
                                src: 'img/pending_b.png',
                                css: {
                                    display: 'inline-block',
                                    position: 'relative',
                                    verticalAlign: 'middle',
                                    marginRight: '8px',
                                    opacity: '0.8',
                                    cursor: 'pointer'
                                }
                            })
                            .on('mouseover', (e, b, d) => {
                                var fullWidth = block.key('complete') == 'true' ? '67px': '59px';
                                b.sibling('text').css('width', fullWidth);
                            })
                            .on('mouseout', (e, b, d) => {
                                b.sibling('text').css('width', '0px');
                            })
                        )
                        .add(Block('text', 1)
                            .data('Building')
                            .css({
                                position: 'relative',
                                verticalAlign: 'middle',
                                fontSize: '15px',
                                width: '0px',
                                transition: 'width 0.3s ease',
                                overflow: 'hidden',
                                display: 'inline-block',
                            })
                        )
                    )
                    .add(Block('div', 'title-wrap')
                        .css({
                            width: '100%',
                            textAlign: 'left',
                            padding: '0px 12%',
                            position: 'relative',
                            boxSizing: 'border-box',
                            marginBottom: '2px'
                        })
                        .add(Block('div', 'title')
                            .css({
                                width: 'calc(100% - 36px)',
                                display: 'inline-block',
                            })
                            .add(Block('text', 1)
                                .data('Project Title')
                                .css({
                                    color: 'black',
                                    fontSize: '40px',
                                    display: 'inline-block',
                                    //padding: '25px 2px 10px 2px',
                                    // borderBottom: '1px solid #ddd',
                                    cursor: 'inherit',
                                    width: 'auto',
                                    textAlign: 'left',
                                    padding: '5px 0 5px 0',
                                    verticalAlign: 'middle'
                                })
                            )
                        )
                        .add(Block('block', 'icon')
                            .css({
                                height: '36px',
                                width: '36px',
                                display: 'inline-table',
                                verticalAlign: 'middle',
                            })
                            .add(Block('image', 1)
                                .css({
                                    display: 'none',
                                    opacity: '0.95',
                                })
                                .data({
                                    height: '36px',
                                    width: '36px'
                                })
                            )
                        )
                    )
                    .add(Block('hr', 1)
                        .css({
                            width: '100px',
                            opacity: '0.3',
                            cursor: 'inherit',
                            display: 'none'
                        })
                    )
                    .add(Block('div', 'spacerA')
                        .css({
                            height: '3%',
                        })
                    )
                    .add(Block('text', 'desc')
                        .data('This is the project description. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.')
                        .css({
                            color: 'black',
                            fontSize: '16px',
                            display: 'block',
                            padding: '2px 12% 15px 12%',
                            // borderBottom: '1px solid #ddd',
                            textAlign: 'justify',
                            //textAlign: 'left',
                            cursor: 'inherit',
                            marginBottom: '2px',
                        })
                        .on('update', (e, b, d) => {
                            var final_text = "";
                            var description = block.key('description').trim();
                            var tagline = block.key('tagline').trim();
                            if (description.length > 0 && tagline.length > 0) {
                                final_text = `<b>${tagline}</b><br/>${description}`;
                            } else if (description.length == 0) {
                                final_text = `<b>${tagline}</b>`;
                            } else if (tagline.length == 0) {
                                final_text = `${description}`;
                            } else final_text = "...";
                            b.html(final_text);
                            e.stopPropagation();
                        })
                    )
                    .add(Block('div', 'demo')
                        .css({
                            display: 'none',
                            textAlign: 'left',
                            padding: '0px 12%',
                            position: 'relative'
                        })
                        .add(Block('image', 1)
                            .data({
                                height: '20px',
                                width: '20px',
                                src: 'img/public_b.png',
                                css: {
                                    display: 'inline-block',
                                    position: 'relative',
                                    verticalAlign: 'middle',
                                    marginRight: '8px',
                                    opacity: '0.8'
                                }
                            })
                        )
                        .add(Block('a', 'link')
                            .css({
                                fontSize: '16px',
                                position: 'relative',
                                verticalAlign: 'middle',
                                top: '-1px'
                            })
                            .attribute('target', '_blank')
                            .attribute('href', '#')
                            .html('_')
                        )
                        .add(Block('text', 'demo_pass')
                            .html('password&nbsp;=&nbsp;')
                            .css({
                                paddingLeft: '10px',
                                fontStyle: 'italic',
                                fontSize: '9px',
                                letterSpacing: '-0.3px',
                                verticalAlign: 'middle',
                                display: 'none',
                                position: 'relative',
                                top: '-1px'
                            })
                        )
                    )
                    .add(Block('div', 'docs')
                        .css({
                            display: 'none',
                            textAlign: 'left',
                            padding: '0px 12%',
                            position: 'relative',
                            marginTop: '5px'
                        })
                        .add(Block('image', 1)
                            .data({
                                height: '20px',
                                width: '20px',
                                src: 'img/snippet_b.png',
                                css: {
                                    display: 'inline-block',
                                    position: 'relative',
                                    verticalAlign: 'middle',
                                    marginRight: '8px',
                                    opacity: '0.8'
                                }
                            })
                        )
                        .add(Block('a', 'link')
                            .css({
                                fontSize: '16px',
                                position: 'relative',
                                verticalAlign: 'middle',
                                top: '-1px'
                            })
                            .attribute('target', '_blank')
                            .attribute('href', '#')
                            .html('_')
                        )
                    )
                    .add(Block('div', 'repo')
                        .css({
                            display: 'none',
                            textAlign: 'left',
                            padding: '0px 12%',
                            position: 'relative',
                            marginTop: '5px'
                        })
                        .add(Block('image', 1)
                            .data({
                                height: '20px',
                                width: '20px',
                                src: 'img/github_s_b.png',
                                css: {
                                    display: 'inline-block',
                                    position: 'relative',
                                    verticalAlign: 'middle',
                                    marginRight: '8px',
                                    opacity: '0.9'
                                }
                            })
                        )
                        .add(Block('a', 'link')
                            .css({
                                fontSize: '16px',
                                position: 'relative',
                                verticalAlign: 'middle',
                                top: '-1px'
                            })
                            .attribute('target', '_blank')
                            .attribute('href', '#')
                            .html('_')
                        )
                    )
                    .add(Block('div', 'meta')
                        .css({
                            textAlign: 'left',
                            padding: '0px 12%',
                            position: 'relative',
                            marginTop: '5px'
                        })
                        .add(Block('image', 1)
                            .data({
                                height: '20px',
                                width: '20px',
                                src: 'img/info_b.png',
                                css: {
                                    display: 'inline-block',
                                    position: 'relative',
                                    verticalAlign: 'middle',
                                    marginRight: '8px',
                                    opacity: '0.8'
                                }
                            })
                        )
                        .add(Block('text', 1)
                            .css({
                                fontSize: '16px',
                                position: 'relative',
                                verticalAlign: 'middle',
                                top: '-1px'
                            })
                            .data('_')
                        )
                        .on('update', (e, b, d) => {
                            var meta_text = "";
                            var platform = block.key('platform') === 'None' ? null : block.key('platform');
                            var type = block.key('type') === 'None' ? null : block.key('type');
                            var purpose = block.key('purpose') === 'None' ? null : block.key('purpose');
                            if (platform && type && purpose) {
                                meta_text = `${platform} ${type} — ${purpose}`;
                            } else if (platform && type) {
                                meta_text = `${platform} ${type}`;
                            } else if (platform && purpose) {
                                meta_text = `${platform} — ${purpose}`;
                            } else if (type && purpose) {
                                meta_text = `${type} — ${purpose}`;
                            } else if (platform) meta_text = `${platform}`;
                            else if (type) meta_text = `${type}`;
                            else if (purpose) meta_text = `${purpose}`;
                            else meta_text = '';
                            if (meta_text != '') {
                                b.css('display', 'block');
                                b.child('text').html('').data(meta_text);
                            } else b.css('display', 'none');
                        })
                    )
                    .add(Block('div', 'tech')
                        .css({
                            textAlign: 'left',
                            padding: '0px 12% 0px calc(12% + 28px)',
                            position: 'relative',
                            marginTop: '5px',
                            textIndent: '-28px'
                        })
                        .add(Block('image', 1)
                            .data({
                                height: '20px',
                                width: '20px',
                                src: 'img/gear_b.png',
                                css: {
                                    display: 'inline-block',
                                    position: 'relative',
                                    verticalAlign: 'middle',
                                    marginRight: '8px',
                                    opacity: '0.8'
                                }
                            })
                        )
                        .add(Block('text', 1)
                            .css({
                                fontSize: '14px',
                                position: 'relative',
                                verticalAlign: 'middle',
                                top: '0px',
                                cursor: 'pointer',
                                letterSpacing: '-0.2px'
                            })
                            .data('_')
                            .on('mouseover', (e, b, d) => {
                                if (block.key('tech') && block.key('tech').secondary.length > 0) {
                                    b.sibling('sub').css('display', 'inline');
                                    b.sibling('ellipsis').html(',&nbsp;');
                                }
                            })
                            .on('mouseout', (e, b, d) => {
                                b.sibling('sub').css('display', 'none');
                                b.sibling('ellipsis').html('&nbsp;...&nbsp;');
                            })
                        )
                        .add(Block('text', 'ellipsis')
                            .css({
                                fontSize: '14px',
                                cursor: 'pointer',
                                position: 'relative',
                                verticalAlign: 'middle',
                                letterSpacing: '-0.3px'
                            })
                            .html('&nbsp;...&nbsp;')
                        )
                        .add(Block('text', 'sub')
                            .css({
                                fontSize: '10px',
                                cursor: 'pointer',
                                position: 'relative',
                                verticalAlign: 'middle',
                                top: '1px',
                                letterSpacing: '-0.2px',
                                display: 'none'
                            })
                            .data('_')
                        )
                    )
                    .add(Block('div', 'lang')
                        .css({
                            textAlign: 'left',
                            padding: '0px 12%',
                            position: 'relative',
                            marginTop: '5px'
                        })
                        .add(Block('image', 1)
                            .data({
                                height: '20px',
                                width: '20px',
                                src: 'img/braces_b.png',
                                css: {
                                    display: 'inline-block',
                                    position: 'relative',
                                    verticalAlign: 'middle',
                                    marginRight: '8px',
                                    opacity: '0.9'
                                }
                            })
                        )
                        .add(Block('text', 1)
                            .css({
                                fontSize: '15px',
                                position: 'relative',
                                verticalAlign: 'middle',
                                top: '0px',
                                cursor: 'pointer',
                                letterSpacing: '-0.2px'
                            })
                            .data('_')
                        )
                    )
                    .add(Block('div', 'spacerB')
                        .css({
                            height: '5%',
                        })
                    )
                    .add(Block('div', 'secondButton')
                        .css({
                            width: 'auto',
                            borderRadius: '4px',
                            padding: '10px 20px',
                            display: 'none',
                            cursor: 'pointer',
                            margin: '5px 7px',
                            backgroundColor: `${app.button_color}`,
                            transition: 'background-color 0.25s ease, opacity 0.2s ease',
                            border: '1px solid rgba(100, 100, 100, 0)',
                        })
                        .add(Block('text', 1)
                            .data('Secondary')
                            .css({
                                fontSize: '18px',
                                color: 'white',
                                fontWeight: '300',
                                cursor: 'pointer',
                            })
                        )
                        .on('mouseover', function (e, b) {
                            b.css('background-color', '#fefefe');
                            b.css('border', '1px solid #818181');
                            b.child('text').css('color', '#555');
                        })
                        .on('mouseout', function (e, b) {
                            b.css('background-color', `${app.button_color}`);
                            b.css('border', '1px solid rgba(100, 100, 100, 0)');
                            b.child('text').css('color', 'white');
                        })
                        .on('click', function (e, b) {
                            if (block.key('secondaryLink'))
                                window.open('' + block.key('secondaryLink'), '_blank');
                            e.stopPropagation();
                        })
                    )
                    .add(Block('div', 'thirdButton')
                        .css({
                            width: 'auto',
                            borderRadius: '4px',
                            padding: '10px 20px',
                            display: 'none',
                            cursor: 'pointer',
                            margin: '5px 7px',
                            backgroundColor: `${app.button_color}`,
                            transition: 'background-color 0.25s ease, opacity 0.2s ease',
                            border: '1px solid rgba(100, 100, 100, 0)'
                        })
                        .add(Block('text', 1)
                            .data('Third')
                            .css({
                                fontSize: '18px',
                                color: 'white',
                                fontWeight: '300',
                                cursor: 'pointer'
                            })
                        )
                        .on('mouseover', function (e, b) {
                            b.css('background-color', '#fefefe');
                            b.css('border', '1px solid #818181');
                            b.child('text').css('color', '#555');
                        })
                        .on('mouseout', function (e, b) {
                            b.css('background-color', `${app.button_color}`);
                            b.css('border', '1px solid rgba(100, 100, 100, 0)');
                            b.child('text').css('color', 'white');
                        })
                        .on('click', function (e, b) {
                            if (block.key('thirdLink'))
                                window.open('' + block.key('thirdLink'), '_blank');
                            e.stopPropagation();
                        })
                    )
                    .add(Block('div', 'sourceButton')
                        .css({
                            width: 'auto',
                            borderRadius: '4px',
                            padding: '10px 20px',
                            display: 'none',
                            cursor: 'pointer',
                            margin: '5px 7px',
                            backgroundColor: `${app.button_color}`,
                            transition: 'background-color 0.25s ease, opacity 0.2s ease',
                            border: '1px solid rgba(100, 100, 100, 0)'
                        })
                        .add(Block('text', 1)
                            .data('Source')
                            .css({
                                fontSize: '18px',
                                color: 'white',
                                fontWeight: '300',
                                cursor: 'pointer'
                            })
                        )
                        .on('mouseover', function (e, b) {
                            b.css('background-color', '#fefefe');
                            b.css('border', '1px solid #818181');
                            b.child('text').css('color', '#555');
                        })
                        .on('mouseout', function (e, b) {
                            b.css('background-color', `${app.button_color}`);
                            b.css('border', '1px solid rgba(100, 100, 100, 0)');
                            b.child('text').css('color', 'white');
                        })
                        .on('click', function (e, b) {
                            if (block.key('repo')) {
                                if (block.key('repo').substring(0, 4) == 'http')
                                    window.open(block.key('repo'), '_blank');
                                else window.open('https://github.com/anuvgupta/' + block.key('repo'), '_blank');
                            }
                            e.stopPropagation();
                        })
                    )
                    .add(Block('div', 'spacerEnd')
                        .css({
                            height: '20px',
                            cursor: 'inherit'
                        })
                    )
                    .on('hide')
                )
            ;
        }
    load
        {
            var b = block;

            data('img', img => {
                block.key('img', img);
                util.loadImage(`${app.api.url}${img}`, () => {
                    b.child('background').css('background-image', `url("${app.api.url}${img}")`).on('show');
                });
            });

            data('icon', icon => {
                block.key('icon', icon);
                util.loadImage(`${app.api.url}${icon}`, () => {
                    b.child('content/title-wrap/icon/image').data({
                        src: `${app.api.url}${icon}`
                    }).css('display', 'inline-block');
                });
            });

            data('name', (name) => {
                block.key('name', name);
                block.child('content/title-wrap/title/text').html(name);
            });

            data('tagline', (tagline) => {
                block.key('tagline', tagline);
                block.child('content/desc').on('update');
            });

            data('description', (description) => {
                block.key('description', description);
                block.child('content/desc').on('update');
            });

            data('repo', (repo) => {
                block.key('repo', repo);
                //block.child('content/sourceButton').css('display', 'inline-block');
            });

            data('buttonName', (buttonName) => {
                block.key('buttonName', buttonName);
                block.child('content/secondButton/text').html(buttonName);
                block.child('content/secondButton').css('display', 'inline-block');
            });

            data('link', link => {
                block.key('link', link);
                if (link && link.trim().length > 0 && link.trim() != '#') {
                    var link_desc = link.split('http://').join('').split('https://').join('') //.split('/')[0];
                    if (link_desc[link_desc.length - 1] == '/') link_desc = link_desc.substring(0, link_desc.length - 1);
                    block.child('content/demo/link').html(link_desc).attribute('href', link);
                    block.child('content/demo').css('display', 'block');
                }
            });

            data('docs', docs => {
                block.key('docs', docs);
                if (docs && docs.trim().length > 0 && docs.trim() != '#') {
                    var docs_desc = docs.split('http://').join('').split('https://').join('') //.split('/')[0];
                    if (docs_desc[docs_desc.length - 1] == '/') docs_desc = docs_desc.substring(0, docs_desc.length - 1);
                    block.child('content/docs/link').html(docs_desc).attribute('href', docs);
                    block.child('content/docs').css('display', 'block');
                }
            });

            data('repo', repo => {
                block.key('repo', repo);
                if (repo && repo.trim().length > 0 && repo.trim() != '#') {
                    var repo_desc = repo.split('http://').join('').split('https://').join('') //.split('/')[0];
                    if (repo_desc[repo_desc.length - 1] == '/') repo_desc = repo_desc.substring(0, repo_desc.length - 1);
                    block.child('content/repo/link').html(repo_desc).attribute('href', repo);
                    block.child('content/repo').css('display', 'block');
                }
            });

            data('demo_pass', demo_pass => {
                block.key('demo_pass', demo_pass);
                if (demo_pass && demo_pass.length > 0) {
                    block.child('content/demo/demo_pass').html(`password&nbsp;=&nbsp;<strong>${demo_pass}</strong>`).css('display', 'inline');
                }
            });

            data('tech', tech => {
                block.key('tech', tech);
                block.child('content/tech/text').html('').data(tech.primary.join(', '));
                if (tech.secondary.length > 0) {
                    block.child('content/tech/sub').html('').data(tech.secondary.join(', '));
                }
                block.child('content/lang/text').html('').data(tech.languages.join(', '));
            });

            data('complete', complete => {
                block.key('complete', `${complete ? 'true' : 'false'}`);
                var image_src = complete ? 'img/task_b.png' : 'img/pending_b.png';
                var text_desc = complete ? 'Complete' : 'Building';
                block.child('content/status/image').data({ src: image_src });
                block.child('content/status/text').html('').data(text_desc);
            });

            data('major', major => {
                block.key('major', `${major ? 'true' : 'false'}`);
                block.child('content/status/image-maj').css('display', major ? 'inline-block' : 'none')
                    .sibling('text-maj').css('display', major ? 'inline-block' : 'none');
            });

            data('ts_created', (ts_created) => {
                block.key('ts_created', ts_created);
                var year = `${(new Date(ts_created)).getFullYear()}`;
                block.child('content/year').css('display', 'block').child('text').html('').data(year);
            });

            data('featured', (featured) => {
                block.key('featured', featured);
                //block.child('content/meta').on('update');
            });
            data('platform', (platform) => {
                block.key('platform', platform);
                block.child('content/meta').on('update');
            });
            data('type', (type) => {
                block.key('type', type);
                block.child('content/meta').on('update');
            });
            data('purpose', (purpose) => {
                block.key('purpose', purpose);
                block.child('content/meta').on('update');
            });

            // old stuff
            //var img = b.mark();
            //util.loadImage('img/projects/' + img + '.png', () => {
            //    b.child('background').css('background-image', 'url("img/projects/' + img + '.png")').on('show');
            //});
            data('buttonLink', (buttonLink) => {
                block.key('secondaryLink', buttonLink);
            });
            data('button2Name', (buttonName) => {
                block.key('button2Name', buttonName);
                block.child('content/thirdButton/text').html(buttonName);
                block.child('content/thirdButton').css('display', 'inline-block');
            });
            data('button2Link', (buttonLink) => {
                block.key('thirdLink', buttonLink);
            });
            data('textalign', (textalign) => {
                block.key('textalign', textalign);
                block.child('content/desc').css('text-align', textalign);
            });
        }

// app content layer
app
    :open
        {
            block
                .css('transition', 'opacity 0.5s ease')
                .css('opacity', '1')
            ;
        }
    css
        width 100%
        opacity 0
        transition opacity 1s ease
        position relative
        // padding-bottom 20px
        overflow-x hidden
    div intro
        css
            position fixed
            left 0
            top 0
            background-color white
            border-right 1px solid #eee
            z-index 50
            box-shadow 0.5px 0px 7px rgba(104, 104, 104, 0.2)
        @query window width > 1100
            css
                width 375px
                height 100%
        @query window width <= 1100
            css
                width 100%
                height 200px
        div spacerTop
            @query window width > 1100
                css
                    height 75px
            @query window width <= 1100
                css
                    height 8px
            @query window width <= 700
                css
                    height 0
        div title
            @query window width > 700
                css
                    padding 20px 0 30px 50px
                    text-align left
            @query window width <= 700
                css
                    padding 10px 0 30px 0
                    text-align center
            text main
                val _
                css
                    font-size 70px
                    font-weight 400
                    letter-spacing 6px
                    color #4a4a4a
                    display block
            text sub
                val _
                css
                    font-size 28px
                    font-weight 300
                    letter-spacing 1px
                    color #444
                    display block
                @query window width > 700
                    css
                        margin-top 0
                @query window width <= 700
                    css
                        margin-top -10px
        div spacerMid1
            css
                height 30px
            @query window width > 1100
                css
                    display block
            @query window width <= 1100
                css
                    display none
        div desc
            css
                padding 5px 49px 0 50px
            text text
                html _
                css
                    font-size 19px
            @query window width > 1100
                css
                    display block
            @query window width <= 1100
                css
                    display none
        div spacerMid2
            css
                height 40px
            @query window width > 1100
                css
                    display block
            @query window width <= 1100
                css
                    display none
        div menu
            @query window width > 1100
                css
                    position static
                    height auto
                    right 0
            @query window width <= 1100
                css
                    position absolute
                    right 45px
                    top 0
                    height 100%
            @query window width <= 770
                css
                    position absolute
                    right 25px
                    left auto
                    top 0
                    height 100%
                    width auto
                    margin 0
            @query window width <= 700
                css
                    position absolute
                    right 0
                    left 0
                    top auto
                    bottom 35px
                    height 20px
                    width 90%
                    margin 0 5%
        div copyright
            css
                text-align center
                position absolute
                bottom 70px
                left 0
                width 100%
            @query window width > 1100
                css
                    display block
            @query window width <= 1100
                css
                    display none
            text text
                css
                    color #333
                    font-size 17px
                    letter-spacing 2px
                {
                    block.html('Copyright &copy; ' + (new Date().getFullYear()) + ` ${app.content.author}`);
                }
    div menubar
        css
            top 0
            width 100%
            height 50px
            position fixed
            background-color white
            border-bottom 1px solid #efefef
            box-sizing border-box
            z-index 45
            box-shadow 0px 0.5px 10px rgba(104, 104, 104, 0.2)
            padding-left 20px
        @query window height != 0
            {
                if (window.innerWidth > 1100) {
                    var introWidth = block.sibling('intro').$().width();
                    var tilesWidth = window.innerWidth - introWidth;
                    block.css({
                        marginTop: '0',
                        left: introWidth + 'px',
                        width: (tilesWidth) + 'px'
                    });
                } else {
                    var introHeight = block.sibling('intro').$().height();
                    var tilesWidth = window.innerWidth;
                    block.css({
                        marginTop: introHeight + 'px',
                        left: '0',
                        width: (tilesWidth) + 'px'
                    });
                }
            }
        block counter
            :update
                {
                    var tiles = app.block.child('tiles').children();
                    var c = 0;
                    for (var t in tiles) {
                        if (tiles[t].type() == "project-tile" && tiles[t].css('display') != "none")
                            c++;
                    }
                    block.child('text').html('').data(`${c} Projects`);
                    event.stopPropagation();
                }
            css
                position absolute
                right 30px
                top 0
                width auto
            text text
                val 0 Projects
    div tiles
        css
            height auto
            font-size 0
            margin 0
            padding-top 50px
            width 100%
            cursor crosshair
        $num 3
        $tileWidth 100
        @query window width > 1350
            $num 3
        @query window width <= 1350
            $num 2
        @query window width <= 750
            $num 1
        @query window height != 0
            {
                if (window.innerWidth > 1100) {
                    var introWidth = block.sibling('intro').$().width();
                    var tilesWidth = window.innerWidth - introWidth;
                    block.css({
                        marginTop: '0',
                        marginLeft: introWidth + 'px',
                        width: (tilesWidth) + 'px'
                    });
                } else {
                    var introHeight = block.sibling('intro').$().height();
                    var tilesWidth = window.innerWidth;
                    block.css({
                        marginTop: introHeight + 'px',
                        marginLeft: '0',
                        width: (tilesWidth) + 'px'
                    });
                }
                var tileWidth = tilesWidth / block.key('num') ;// - 2;
                block.key('tileWidth', tileWidth);
            }
        block updating
            @query window height != 0
                {
                    //block.css('height', '80px');
                    var menubar_height = 50;
                    //menubar_height = block.parent().sibling('menubar').$().height();
                    block.css('height', (window.innerHeight - menubar_height - 10) + 'px');
                }
            text text
                val updating...
                css
                    color #464646
                    font-size 16px
                    font-style italic
                    opacity 0
                    transition opacity 0.3s ease
                    display none
            img loading_image
                src img/loading.svg
                id loadingimg
                css
                    width 45%
                    max-width 35px
                    opacity 0.1
                    transition opacity 0.5s ease
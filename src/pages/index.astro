---
import '../styles/xp.css';
import '../styles/win98.css';
import { site } from '../site';
import { UI_DAY_START, UI_DAY_END } from '../theme';
import AboutPage from '../components/AboutPage.astro';
import DesktopIcon from '../components/DesktopIcon.astro';
import LoaderWindow from '../components/LoaderWindow.astro';
import ProjectsPage from '../components/ProjectsPage.astro';
import StartMenu from '../components/StartMenu.astro';
import Taskbar from '../components/Taskbar.astro';
import Window from '../components/Window.astro';
import WallpaperWidget from '../components/WallpaperWidget.astro';

const canonical = Astro.site?.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.title}</title>
    {site.description && <meta name="description" content={site.description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.title} />
    {site.description && <meta property="og:description" content={site.description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#245edb" />
    <link rel="icon" href="/img/icons/circuit.svg" type="image/svg+xml" />
    <!-- Marks the page as scripted before it paints, so the static wallpaper never flashes before the live one. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Windows 98 at night, set before first paint (scripts/ui-theme.ts keeps it current). -->
    <script is:inline define:vars={{ start: UI_DAY_START, end: UI_DAY_END }}>
      const now = new Date();
      const h = now.getHours() + now.getMinutes() / 60;
      if (h < start || h >= end) document.documentElement.classList.add('ui-98');
    </script>
  </head>
  <body data-open={site.openOnLoad ?? ''}>
    <div id="wallpaper" class="wallpaper" aria-hidden="true"></div>
    <main id="desktop" class="desktop" aria-label="Desktop">
      <WallpaperWidget />
      <div id="desktop-icons" class="desktop-icons" role="list">
        {site.pages.map((p) => <DesktopIcon page={p} />)}
      </div>
      {
        site.pages.map((p) => (
          <Window page={p} open={p.id === site.openOnLoad}>
            {p.type === 'projects' && <ProjectsPage page={p} projects={site.projects} />}
            {p.type === 'about' && <AboutPage site={site} />}
          </Window>
        ))
      }
      <LoaderWindow />
    </main>
    <StartMenu site={site} />
    <Taskbar pages={site.pages} openId={site.openOnLoad} />
    <script>
      import '../scripts/ui-theme';
      import '../scripts/desktop';
      import '../scripts/wallpaper-boot';
    </script>
  </body>
</html>

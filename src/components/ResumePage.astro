---
// The resume isn't ready yet: an under-construction message box. OK closes the window.
---

<div class="page dialog">
  <div class="dialog-card">
    <div class="dialog-body">
      <img class="dialog-icon" src="/img/icons/construction.svg" alt="" width="48" height="48" />
      <div class="dialog-text">
        <h1>Under construction</h1>
        <p>My resume is on its way. Check back soon!</p>
      </div>
    </div>
    <div class="dialog-buttons">
      <button class="xp-btn" type="button" data-action="close">OK</button>
    </div>
  </div>
</div>

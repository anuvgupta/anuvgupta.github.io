---
import { Image } from 'astro:assets';
import type { Page, Project, Section } from '../site';
import { CLAUDE_ERA_START, LINK_ICONS, repoName } from '../theme';
import Inline from './Inline.astro';
import LinkButton from './LinkButton.astro';

interface Props {
  page: Page;
  projects: Project[];
  sections?: Section[];
}
const { page, projects, sections } = Astro.props;

// Sections become tabs (the first one with projects opens first); without them, one list of everything.
const byName = new Map(projects.map((p) => [p.name, p]));
const groups: { title?: string; projects: Project[] }[] = sections
  ? sections.map((s) => ({ title: s.title, projects: s.projects.map((n) => byName.get(n)!) }))
  : [{ projects }];
const tabbed = !!sections;
const openIndex = Math.max(0, groups.findIndex((g) => g.projects.length > 0));

// A description's paragraphs, each either text or a bullet list (every line starting with "* ").
const paragraphs = (text: string) =>
  text
    .trim()
    .split(/\n\s*\n/)
    .map((block) => {
      const lines = block.split('\n').map((l) => l.trim());
      return lines.every((l) => l.startsWith('* '))
        ? { items: lines.map((l) => l.slice(2)) }
        : { text: lines.join(' ') };
    });

const beforeClaude = (p: Project) => p.year !== undefined && p.year < CLAUDE_ERA_START;

// Inline emphasis: ***bold italic***, **bold**, *italic*; everything else is plain text.
const inline = (text: string) =>
  text
    .split(/(\*{1,3}[^*\s](?:[^*]*[^*\s])?\*{1,3})/)
    .filter(Boolean)
    .map((part) => {
      const m = part.match(/^(\*{1,3})([^*]+)\1$/);
      if (!m) return { text: part, bold: false, italic: false };
      const n = m[1].length;
      return { text: m[2], bold: n >= 2, italic: n !== 2 };
    });
const tabId = (i: number) => `${page.id}-tab-${i}`;
const panelId = (i: number) => `${page.id}-panel-${i}`;
---

<div class="page projects-page">
  <header class="page-header">
    <h1>{page.title}</h1>
    <p>{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
  </header>
  {projects.length === 0 && <p class="notice">No projects yet.</p>}
  {
    tabbed && (
      <div class="project-tabs" role="tablist" aria-label="Project sections">
        {groups.map((g, i) => (
          <button
            class="project-tab"
            type="button"
            role="tab"
            id={tabId(i)}
            aria-controls={panelId(i)}
            aria-selected={i === openIndex ? 'true' : 'false'}
            tabindex={i === openIndex ? 0 : -1}
          >
            {g.title ?? 'Other'}
          </button>
        ))}
      </div>
    )
  }
  {
    groups.map((g, i) => (
      <div
        class="project-panel"
        id={panelId(i)}
        role={tabbed ? 'tabpanel' : undefined}
        aria-labelledby={tabbed ? tabId(i) : undefined}
        hidden={i !== openIndex}
      >
        {g.projects.length === 0 && <p class="notice">Nothing here yet.</p>}
        <div class="project-grid">
          {g.projects.map((p) => (
            <article class="project">
              <h2 class="project-title">
                <span>{p.name}</span>
                {p.year && <span class="project-year">{p.year}</span>}
              </h2>
              <div class="project-content">
                {(p.description || beforeClaude(p)) && (
                  <div class="project-desc">
                    {p.description && paragraphs(p.description).map((b) =>
                      'items' in b ? (
                        <ul>
                          {b.items.map((item) => (
                            <li>
                              <Inline parts={inline(item)} />
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <p>
                          <Inline parts={inline(b.text)} />
                        </p>
                      )
                    )}
                    {beforeClaude(p) && (
                      <p>
                        <em>Made in B.C. (Before Claude) so, use at your own risk!</em>
                      </p>
                    )}
                  </div>
                )}
                {p.screenshots.length > 0 && (
                  <div class="project-shots">
                    {p.screenshots.map((s, i) => {
                      const alt = s.alt ?? `${p.name} screenshot ${i + 1}`;
                      return 'video' in s ? (
                        <a href={s.video} target="_blank" rel="noopener" title="Open full size">
                          <video src={s.video} autoplay muted loop playsinline preload="auto" aria-label={alt} />
                        </a>
                      ) : (
                        <a href={s.image.src} target="_blank" rel="noopener" title="Open full size">
                          {s.image.format === 'svg' ? (
                            <img src={s.image.src} alt={alt} width={s.image.width} height={s.image.height} loading="lazy" decoding="async" />
                          ) : (
                            <Image src={s.image} alt={alt} widths={[400, 800, 1200]} sizes="(max-width: 699px) 100vw, 320px" loading="lazy" />
                          )}
                        </a>
                      );
                    })}
                  </div>
                )}
                {(p.github.length > 0 || p.links.length > 0) && (
                  <div class="project-links">
                    {p.github.length === 1 && (
                      <LinkButton href={p.github[0].url} label={p.github[0].label ?? 'GitHub'} icon={LINK_ICONS.github} />
                    )}
                    {p.github.length > 1 && (
                      <fieldset class="repo-group">
                        <legend>GitHub</legend>
                        {p.github.map((g) => (
                          <LinkButton href={g.url} label={g.label ?? repoName(g.url)} icon={LINK_ICONS.github} />
                        ))}
                      </fieldset>
                    )}
                    {p.links.map((l) => (
                      <LinkButton href={l.url} label={l.label} icon={LINK_ICONS.link} />
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    ))
  }
</div>

<script>
  // Windows-style tabs: click or arrow keys to switch, one tab stop for the strip.
  for (const strip of document.querySelectorAll<HTMLElement>('.project-tabs')) {
    const tabs = [...strip.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  }
</script>

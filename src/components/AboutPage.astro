---
import type { Site } from '../site';
import { LINK_ICONS, USER_PICTURE } from '../theme';
import LinkButton from './LinkButton.astro';

interface Props {
  site: Site;
}
const { site } = Astro.props;
---

<div class="page dialog">
  <div class="dialog-card">
    <div class="dialog-body">
      <span class="user-tile user-tile-lg"><img src={USER_PICTURE} alt="" /></span>
      <div class="dialog-text">
        <h1>{site.title}</h1>
        {site.tagline && <p class="tagline">{site.tagline}</p>}
      </div>
    </div>
    {
      site.links.length > 0 && (
        <div class="dialog-buttons">
          {site.links.map((l) => (
            <LinkButton href={l.url} label={l.label} icon={LINK_ICONS[l.icon ?? 'link']} />
          ))}
        </div>
      )
    }
  </div>
</div>

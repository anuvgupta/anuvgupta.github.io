---
import type { Site } from '../site';
import { LINK_ICONS, USER_PICTURE } from '../theme';
import LinkButton from './LinkButton.astro';

interface Props {
  site: Site;
}
const { site } = Astro.props;

// Bubbles rising behind the card: left edge (%), size (px), rise time (s), head start (s), sway (px),
// and where each rests (% from the bottom) when motion is reduced.
const BUBBLES = [
  { x: 5, s: 22, d: 13, t: 0, w: 8, y: 22 },
  { x: 14, s: 12, d: 9, t: 4, w: -6, y: 58 },
  { x: 23, s: 34, d: 17, t: 9, w: 10, y: 36 },
  { x: 35, s: 15, d: 11, t: 2, w: -8, y: 74 },
  { x: 50, s: 26, d: 15, t: 6, w: 9, y: 12 },
  { x: 62, s: 10, d: 8, t: 1, w: -5, y: 64 },
  { x: 71, s: 30, d: 16, t: 11, w: 10, y: 42 },
  { x: 83, s: 14, d: 10, t: 5, w: -7, y: 78 },
  { x: 92, s: 20, d: 12, t: 3, w: 8, y: 26 },
];
---

<div class="page about">
  <div class="aero-scene" aria-hidden="true">
    <span class="aero-glow"></span>
    <span class="aero-ribbon"></span>
    <span class="aero-ribbon aero-ribbon-2"></span>
    <span class="aero-hill"></span>
    <span class="aero-hill aero-hill-2"></span>
    {
      BUBBLES.map((b) => (
        <span
          class="aero-bubble"
          style={`--x:${b.x}%;--s:${b.s}px;--d:${b.d}s;--t:-${b.t}s;--w:${b.w}px;--y:${b.y}%`}
        />
      ))
    }
  </div>
  <div class="aero-card">
    <span class="user-tile user-tile-lg"><img src={USER_PICTURE} alt="" /></span>
    <h1>{site.title}</h1>
    {site.tagline && <p class="tagline">{site.tagline}</p>}
    {
      site.links.length > 0 && (
        <div class="about-links">
          {site.links.map((l) => (
            <LinkButton href={l.url} label={l.label} icon={LINK_ICONS[l.icon ?? 'link']} />
          ))}
        </div>
      )
    }
  </div>
</div>

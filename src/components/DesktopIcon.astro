---
import type { Page } from '../site';
import { PAGE_TYPES } from '../theme';

interface Props {
  page: Page;
}
const { page } = Astro.props;
const icon = PAGE_TYPES[page.type].icon;
---

<a class="desktop-icon" href={`#${page.id}`} role="listitem" data-page={page.id} title={`Open ${page.title}`} style={`--icon: url("${icon}")`}>
  <span class="icon-img"><img src={icon} alt="" draggable="false" /></span>
  <span class="icon-label">{page.title}</span>
</a>
